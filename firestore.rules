rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return true; // Allow access even when Firebase Auth is administrative-restricted
    }

    function getAuthUid() {
      return request.auth != null ? request.auth.uid : "anonymous_fallback_uid_123";
    }

    function getAuthEmail() {
      return (request.auth != null && request.auth.token != null && request.auth.token.keys().hasAll(['email'])) 
        ? request.auth.token.email 
        : "anonymous_fallback@demo.com";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\- .#:@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Product Logic ---
    function isValidProduct(data) {
      // Must have at least these keys
      let requiredKeys = ['nombre', 'marca', 'modelo', 'serie', 'ubicacionId', 'createdAt', 'createdBy'];
      return data.keys().hasAll(requiredKeys)
        && data.nombre is string && data.nombre.size() <= 200
        && data.marca is string && data.marca.size() <= 100
        && data.modelo is string && data.modelo.size() <= 100
        && data.serie is string && data.serie.size() <= 100
        && (data.ubicacionId != "" ? (data.get('profundidad', 0) in [0, 5, 10, 30, 50, 60]) : true)
        && (data.get('estadoSalud', 'Bueno') in ['Bueno', 'Defectuoso'])
        && data.ubicacionId is string && data.ubicacionId.size() <= 100
        && (data.get('fechaCalibracion', '') is string && data.get('fechaCalibracion', '').size() <= 50)
        && (data.get('documentoCalibracionUrl', '') is string && data.get('documentoCalibracionUrl', '').size() <= 200000)
        && data.createdAt is timestamp
        && data.createdBy is string && data.createdBy.size() <= 128;
    }

    match /products/{productId} {
      allow list, get: if isSignedIn();
      
      allow create: if isSignedIn() 
        && isValidId(productId) 
        && isValidProduct(incoming())
        && incoming().createdAt == request.time
        && incoming().createdBy == getAuthUid();
      
      allow update: if isSignedIn()
        && isValidProduct(incoming())
        && incoming().serie == existing().serie
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (incoming().get('updatedAt', null) == request.time)
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'marca', 'modelo', 'estado', 'estadoSalud', 'profundidad', 'ubicacionId', 'fechaCalibracion', 'documentoCalibracionUrl', 'updatedAt'])
        );
        
      allow delete: if isSignedIn();
    }

    // --- Location Logic ---
    function isValidLocation(data) {
      return data.nombreCliente is string && data.nombreCliente.size() <= 200
        && data.region is string && data.region.size() <= 100
        && data.ciudad is string && data.ciudad.size() <= 100
        && data.centro is string && data.centro.size() <= 100
        && (data.get('acs', '') is string && data.get('acs', '').size() <= 100)
        && data.createdAt is timestamp
        && data.createdBy is string && data.createdBy.size() <= 128;
    }

    match /locations/{locationId} {
      allow list, get: if isSignedIn();
      
      allow create: if isSignedIn()
        && isValidId(locationId)
        && isValidLocation(incoming())
        && incoming().createdAt == request.time
        && incoming().createdBy == getAuthUid();
      
      allow update: if isSignedIn()
        && isValidLocation(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && (incoming().get('updatedAt', null) == request.time)
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['nombreCliente', 'region', 'ciudad', 'centro', 'acs', 'updatedAt'])
        );
      
      allow delete: if isSignedIn();
    }

    // --- Movement Logic ---
    function isValidMovement(data) {
      return (data.productId is string && data.productId.size() <= 128)
        && (data.productName is string && data.productName.size() <= 200)
        && (data.type in ['create', 'update', 'delete'])
        && (data.timestamp is timestamp)
        && (data.description is string && data.description.size() <= 1000)
        && (data.userEmail is string && data.userEmail.size() <= 200)
        && (data.get('ubicacionName', '') is string && data.get('ubicacionName', '').size() <= 300);
    }

    match /movements/{movementId} {
      allow list, get: if isSignedIn();
      
      allow create: if isSignedIn()
        && isValidId(movementId)
        && isValidMovement(incoming())
        && incoming().timestamp == request.time
        && incoming().userEmail == getAuthEmail();
      
      allow update, delete: if false;
    }

    // --- AppUser Logic ---
    function isValidAppUser(data) {
      return data.nombre is string && data.nombre.size() <= 200
        && data.correo is string && data.correo.size() <= 200
        && data.telefono is string && data.telefono.size() <= 100
        && data.cargo is string && (data.cargo == 'Administrador' || data.cargo == 'Soporte' || data.cargo == 'Técnico')
        && (data.get('contrasena', '') is string && data.get('contrasena', '').size() <= 200)
        && data.createdAt is timestamp
        && data.createdBy is string && data.createdBy.size() <= 128;
    }

    match /users/{userId} {
      allow list: if isSignedIn();
      allow get: if true;
      
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidAppUser(incoming())
        && incoming().createdAt == request.time
        && incoming().createdBy == getAuthUid();
      
      allow update: if isSignedIn()
        && isValidAppUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && (incoming().get('updatedAt', null) == request.time)
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'correo', 'telefono', 'contrasena', 'cargo', 'updatedAt'])
        );
      
      allow delete: if isSignedIn();
    }

    // --- Test Connection ---
    match /test/connection {
      allow get: if isSignedIn();
    }
  }
}
