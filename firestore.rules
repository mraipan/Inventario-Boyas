rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /test/{document=**} {
      allow read: if isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Product Logic ---
    function isValidProduct(data) {
      return data.keys().hasAll(['nombre', 'marca', 'modelo', 'serie', 'estado', 'ubicacionId', 'createdAt', 'createdBy'])
        && data.nombre is string && data.nombre.size() <= 200
        && data.marca is string && data.marca.size() <= 100
        && data.modelo is string && data.modelo.size() <= 100
        && data.serie is string && data.serie.size() <= 100
        && data.estado in ['Bueno', 'Malo']
        && data.ubicacionId is string && data.ubicacionId.size() <= 100
        && (data.get('fechaCalibracion', '') is string && data.get('fechaCalibracion', '').size() <= 50)
        && (data.get('documentoCalibracionUrl', '') is string && data.get('documentoCalibracionUrl', '').size() <= 1000)
        && data.createdAt is timestamp
        && data.createdBy is string && data.createdBy.size() <= 100;
    }

    match /products/{productId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      
      allow create: if isSignedIn() 
        && isValidId(productId) 
        && productId == incoming().serie
        && isValidProduct(incoming())
        && incoming().createdAt == request.time
        && incoming().createdBy == request.auth.uid;
      
      allow update: if isSignedIn()
        && isValidProduct(incoming())
        && incoming().serie == existing().serie
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (incoming().get('updatedAt', null) == request.time)
        && (
          // Update action: general edit
          incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'marca', 'modelo', 'estado', 'ubicacionId', 'fechaCalibracion', 'documentoCalibracionUrl', 'updatedAt'])
        );
        
      allow delete: if isSignedIn();
    }

    // --- Location Logic ---
    function isValidLocation(data) {
      return (data.get('nombreCliente', '') is string && data.get('nombreCliente', '').size() <= 200)
        && (data.get('region', '') is string && data.get('region', '').size() <= 100)
        && (data.get('ciudad', '') is string && data.get('ciudad', '').size() <= 100)
        && (data.get('centro', '') is string && data.get('centro', '').size() <= 100)
        && (data.get('createdAt', request.time) is timestamp)
        && (data.get('createdBy', 'default') is string && data.get('createdBy', 'default').size() <= 128)
        && (data.get('updatedAt', request.time) is timestamp);
    }

    match /locations/{locationId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(locationId)
        && incoming().keys().hasAll(['nombreCliente', 'region', 'ciudad', 'centro', 'createdAt', 'createdBy'])
        && isValidLocation(incoming())
        && incoming().createdAt == request.time
        && incoming().createdBy == request.auth.uid;
      
      allow update: if isSignedIn()
        && isValidLocation(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && (incoming().get('updatedAt', null) == request.time)
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['nombreCliente', 'region', 'ciudad', 'centro', 'updatedAt'])
        );
      
      allow delete: if isSignedIn();
    }

    // --- Movement Logic ---
    function isValidMovement(data) {
      return data.keys().hasAll(['productId', 'productName', 'type', 'timestamp', 'description', 'userEmail'])
        && data.productId is string && data.productId.size() <= 128
        && data.productName is string && data.productName.size() <= 200
        && data.type in ['create', 'update', 'delete']
        && data.timestamp == request.time
        && data.description is string && data.description.size() <= 1000
        && data.userEmail == request.auth.token.email;
    }

    match /movements/{movementId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(movementId)
        && isValidMovement(incoming());
      
      allow update, delete: if false;
    }
  }
}
