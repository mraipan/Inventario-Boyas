{
  "entities": {
    "Product": {
      "title": "Producto de Inventario",
      "description": "Un producto individual en el inventario.",
      "type": "object",
      "properties": {
        "nombre": { "type": "string", "description": "Nombre del producto" },
        "marca": { "type": "string", "description": "Marca del fabricante" },
        "modelo": { "type": "string", "description": "Modelo del producto" },
        "serie": { "type": "string", "description": "Número de serie único" },
        "estadoSalud": { "type": "string", "enum": ["Bueno", "Defectuoso"], "description": "Estado de salud/calidad del sensor: Bueno o Defectuoso" },
        "profundidad": { "type": "number", "description": "Profundidad de instalación si aplica" },
        "ubicacionId": { "type": "string", "description": "ID de la ubicación asociada" },
        "fechaCalibracion": { "type": "string", "format": "date", "description": "Fecha de la última calibración" },
        "documentoCalibracionUrl": { "type": "string", "description": "URL del documento de calibración" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["nombre", "marca", "modelo", "serie", "ubicacionId", "createdAt", "createdBy"]
    },
    "Location": {
      "title": "Ubicación",
      "description": "Ubicación geográfica o de cliente para los productos.",
      "type": "object",
      "properties": {
        "nombreCliente": { "type": "string", "description": "Nombre del cliente" },
        "region": { "type": "string", "description": "Región de ubicación" },
        "ciudad": { "type": "string", "description": "Ciudad de ubicación" },
        "centro": { "type": "string", "description": "Centro o sede específica" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["nombreCliente", "region", "ciudad", "centro", "createdAt", "createdBy"]
    },
    "Movement": {
      "title": "Movimiento",
      "description": "Registro de cambios en el inventario para reportes.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string", "enum": ["create", "update", "delete"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "userEmail": { "type": "string" }
      },
      "required": ["productId", "type", "timestamp", "userEmail"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Colección de productos. El productId será el número de serie para garantizar unicidad."
    },
    "locations/{locationId}": {
      "schema": "Location",
      "description": "Colección de ubicaciones disponibles."
    },
    "movements/{movementId}": {
      "schema": "Movement",
      "description": "Registro histórico de movimientos."
    }
  }
}
